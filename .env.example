# urbanwinebox.com credentials. Omit both to run anonymously (search and browsing
# only; get_orders/get_order_details/get_wishlist/get_cart return a "login required"
# error).
URBANWINEBOX_EMAIL=you@example.com
URBANWINEBOX_PASSWORD=your-password

# Set to 1 to register add_to_cart/remove_from_cart. Requires credentials above.
# Omit (or leave unset) to run read-only, even with credentials present.
URBANWINEBOX_ENABLE_CART_WRITES=1

# Optional: MCP transport. Default is stdio; set MCP_TRANSPORT=http to serve
# Streamable HTTP instead. HTTP always binds loopback-only.
#MCP_TRANSPORT=http
#MCP_HTTP_PORT=8787
#MCP_HTTP_HOST=127.0.0.1
